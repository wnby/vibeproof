# API scanning is disabled until this root is explicitly configured.
# Requests may only scan descendants of this directory.
VIBEPROOF_WORKSPACE_ROOT=D:/repositories

# Optional model configuration. The default `mock` provider needs no network or key.
VIBEPROOF_AI_PROVIDER=mock
VIBEPROOF_AI_MODEL=
VIBEPROOF_AI_BASE_URL=
VIBEPROOF_AI_API_KEY=
